# Production env. Copy to .env on the VPS: `cp .env.prod.example .env`
# Never commit .env. Never reuse dev passwords in prod.

# Public domain served by Caddy (required). Must match your DNS A-record.
# Example: SITE_DOMAIN=example.com
SITE_DOMAIN=example.com

# Optional contact for Let's Encrypt expiry notices. Leave empty to skip.
# Example: ACME_EMAIL=you@example.com
ACME_EMAIL=

# Admin login for /#/admin (required — MUST be strong, unique, 20+ chars).
# Generate one with: openssl rand -base64 24
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE-ME-generate-a-strong-password-with-openssl-rand-base64-24

SITE_NAME=LinuxStream

# NOTE: WEB_PORT is intentionally removed here. Caddy owns 80/443 in prod;
# `web` is exposed internally only (see docker-compose.prod.yml).
# Do not set WEB_PORT in prod.

# Database: SQLite default (single VPS, zero extra services).
DB_DRIVER=sqlite
DB_PATH=/data/brand.db
# Only when DB_DRIVER=mysql (plus --profile mysql):
# MYSQL_DSN=mysql://root:changeme@db:3306/brand
# MYSQL_ROOT_PASSWORD=changeme-generate-a-strong-one-too

# IMPORTANT: Adsterra codes are domain-bound. Codes approved for localhost or
# another domain render blank on SITE_DOMAIN. After DNS + HTTPS are live,
# get SITE_DOMAIN approved in the Adsterra dashboard, then paste the codes
# for SITE_DOMAIN in /#/admin.
