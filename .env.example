# Copy to .env and fill in. Never commit .env.
WEB_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=changeme-on-first-boot
SITE_NAME=LinuxStream
SITE_DOMAIN=example.com
DB_DRIVER=sqlite
DB_PATH=/data/brand.db
# Only when DB_DRIVER=mysql (plus: docker compose --profile mysql up -d):
MYSQL_DSN=mysql://root:changeme@db:3306/brand
MYSQL_ROOT_PASSWORD=changeme
